# Copy this file to .env and fill in your values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_WALLET_ENCRYPTION_KEY=your-32-char-wallet-key-here!!

# ── NetReward Tracker SDK (from Dashboard → Settings → Integrated Platforms) ──
# API Key  : used in the x-sp-api-key header sent to /functions/v1/tracking
# API Secret: Must now be set securely in Supabase Edge Function secrets as NRT_API_SECRET
VITE_NRT_API_KEY=nr_live_xxxxxxxxxxxxxxxxxxxx

# ── NetReward Webhook (server-side Supabase secret — NOT exposed to the browser) ──
# Set via: supabase secrets set NRT_WEBHOOK_SECRET=whsec_...
# NRT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
