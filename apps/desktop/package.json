{
  "name": "netreward-desktop",
  "version": "1.0.0",
  "description": "NetReward Desktop — Earn NRT rewards from your network data",
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "dev:renderer": "cd ../../ && npm run dev",
    "prebuild": "cd ../../ && npm run build && cd apps/desktop && rm -rf dist && cp -R ../../dist ./dist",
    "build": "tsc -p tsconfig.json && electron-builder",
    "build:win": "npm run prebuild && tsc -p tsconfig.json && electron-builder --win",
    "build:mac": "npm run prebuild && tsc -p tsconfig.json && electron-builder --mac",
    "build:linux": "npm run prebuild && tsc -p tsconfig.json && electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.netreward.desktop",
    "productName": "NetReward",
    "copyright": "Copyright © 2026 NetReward",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*.js",
      "preload/**/*.js",
      "assets/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetReward"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/icon.png",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/icon.png",
      "category": "Finance"
    },
    "publish": {
      "provider": "github",
      "owner": "daprof12",
      "repo": "NetReward-Desktop"
    }
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "electron-updater": "^6.0.0",
    "systeminformation": "^5.31.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^8.0.0"
  }
}
