{
  "expo": {
    "name": "NetReward",
    "slug": "NRT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nrt-logo.png",
    "scheme": "netreward",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/nrt-logo.png",
      "bundleIdentifier": "com.netreward.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d1a",
        "foregroundImage": "./assets/images/nrt-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.netreward.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nrt-logo.png"
    },
    "updates": {
      "url": "https://u.expo.dev/YOUR-PROJECT-ID",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0d1a",
          "android": {
            "image": "./assets/images/nrt-logo.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc86e5dd-8140-4757-a829-3b199eff781c"
      }
    },
    "owner": "netreward"
  }
}
